#include <winver.h>

// Application manifest (common controls v6, DPI awareness, asInvoker)
1 24 "app.manifest"

// Icon with the lowest id becomes the .exe icon
1  ICON "../assets/app.ico"
10 ICON "../assets/green.ico"
11 ICON "../assets/red.ico"
12 ICON "../assets/gray.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     0,2,0,0
PRODUCTVERSION  0,2,0,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName",      "Holbootla"
      VALUE "FileDescription",  "IP Tray Monitor"
      VALUE "FileVersion",      "0.2.0"
      VALUE "InternalName",     "ip-tray-monitor"
      VALUE "OriginalFilename", "ip-tray-monitor.exe"
      VALUE "ProductName",      "IP Tray Monitor"
      VALUE "ProductVersion",   "0.2.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
